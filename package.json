{
  "name": "npr-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Find your closest NPR News member station on an interactive map, with FM broadcast coverage estimated from FCC transmitter data.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick123pig/nprmap.git"
  },
